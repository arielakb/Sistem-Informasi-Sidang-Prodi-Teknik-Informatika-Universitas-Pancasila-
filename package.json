{
  "name": "sistem-administrasi-skripsi",
  "version": "1.0.0",
  "description": "Sistem Administrasi Skripsi Universitas Pancasila",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "cd apps/backend && npx prisma migrate dev",
    "db:seed": "cd apps/backend && npx prisma db seed",
    "db:studio": "cd apps/backend && npx prisma studio",
    "db:reset": "cd apps/backend && npx prisma migrate reset --force"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}